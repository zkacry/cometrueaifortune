default_platform(:ios)

platform :ios do
  desc "Fetch/create signing certs & provisioning profile via match"
  lane :signing do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    match(
      type: "appstore",
      readonly: false
    )
  end

  desc "Build signed IPA and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    match(type: "appstore", readonly: false)

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.yourwish.cometrueaifortune"
    )
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: latest_build + 1
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.yourwish.cometrueaifortune" => "match AppStore com.yourwish.cometrueaifortune"
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=\"match AppStore com.yourwish.cometrueaifortune\""
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
