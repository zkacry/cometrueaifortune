default_platform(:ios)

platform :ios do
  desc "Fetch/create signing certs & provisioning profile via match"
  lane :signing do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    match(
      type: "appstore",
      readonly: false
    )
  end

  desc "Build signed IPA and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    match(type: "appstore", readonly: false, api_key: api_key, keychain_password: "")

    # match may generate a profile name with a random numeric suffix
    # (e.g. "match AppStore com.yourwish.cometrueaifortune 1785826872")
    # when a stale/duplicate-named profile exists on the portal. Never
    # hardcode the profile name — always read what match actually resolved.
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["com.yourwish.cometrueaifortune"]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      code_sign_identity: "Apple Distribution",
      team_id: ENV["APPLE_TEAM_ID"],
      profile_name: profile_name,
      targets: ["Runner"],
      build_configurations: ["Release"]
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.yourwish.cometrueaifortune" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success "✅ IPA signed & uploaded to TestFlight"
  end
end
